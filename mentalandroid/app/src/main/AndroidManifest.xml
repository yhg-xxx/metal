<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- 读取手机状态权限 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS"/>
    <uses-permission android:name="android.permission.READ_SMS"/>
    
    <!-- 视频通话所需权限 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    
    <!-- 任务提醒所需权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    
    <!-- 声明电话功能为可选，解决Chrome OS兼容性问题 -->
    <uses-feature android:name="android.hardware.telephony" android:required="false"/>
    <!-- 声明相机和麦克风为可选，增加应用兼容性 -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mental"
        tools:targetApi="31">
        <activity
            android:name=".splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Mental.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mental" />
        <activity
            android:name=".ui.screens.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Mental.NoActionBar" />
        <activity
            android:name=".ui.features.ProfileEditActivity"
            android:exported="false"
            android:theme="@style/Theme.Mental" />
        <activity
            android:name=".ui.features.CounselorSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.Mental" />
        <activity
            android:name=".ui.features.QuickConsultationActivity"
            android:exported="false"
            android:theme="@style/Theme.Mental" />
        <activity
            android:name=".ui.features.IconDisplayActivity"
            android:exported="false"
            android:theme="@style/Theme.Mental" />
        <activity
            android:name=".ui.features.CounselorDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Mental" />
        <activity
            android:name=".ui.features.ChatDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Mental"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".ui.features.VideoDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Mental" />
        <activity
            android:name=".ui.features.TestQuestionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Mental" />
        <activity
            android:name=".ui.features.AssessmentReportActivity"
            android:exported="false"
            android:theme="@style/Theme.Mental" />

        <activity
            android:name=".ui.features.VideoCallActivity"
            android:exported="false"
            android:theme="@style/Theme.Mental"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout" />
        
        <activity
            android:name=".ui.features.ChildInfoScreenActivity"
            android:exported="false"
            android:theme="@style/Theme.Mental" />
        
        <!-- 任务提醒广播接收器 -->
        <receiver
            android:name=".util.TaskReminderService$TaskReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.example.TASK_REMINDER" />
            </intent-filter>
        </receiver>

    </application>

</manifest>